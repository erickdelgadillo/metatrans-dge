manifest {
    name = 'metatrans-dge'
    description = 'Canonical edgeR differential-expression workflow for metatranscriptomic count data'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
}

params {
    counts = null
    metadata = null
    contrasts = null
    fdr = 0.05
    logfc = 1
    outdir = 'results'
    publish_mode = 'copy'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    cpus = 6
    memory = 6.GB
}

profiles {

    test {
        params.counts = "${projectDir}/tests/data/canonical/counts.tsv"
        params.metadata = "${projectDir}/tests/data/canonical/metadata.tsv"
        params.contrasts = "${projectDir}/tests/data/canonical/contrasts.tsv"
        params.outdir = "${projectDir}/results"
    }

    docker {
    docker.enabled = true
    docker.runOptions = '-u $(id -u):$(id -g)'
    process.container = 'metatrans-dge:dev'
    }
}